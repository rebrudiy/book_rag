BOOKRAG_DATA_DIR=./data
BOOKRAG_HOST=127.0.0.1
BOOKRAG_PORT=8000
# Optional local embedding model; installed with uv sync --extra semantic
BOOKRAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional shared cache for embedding/reranker weights across local snapshots
# BOOKRAG_MODEL_CACHE=./data/models
# Custom embedding revisions should be pinned; registered defaults already are
# BOOKRAG_EMBEDDING_REVISION=<commit-sha>
