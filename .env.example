BOOKRAG_DATA_DIR=./data
BOOKRAG_HOST=127.0.0.1
BOOKRAG_PORT=8000
# Optional local embedding model; installed with uv sync --extra semantic
BOOKRAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional shared cache for embedding/reranker weights across local snapshots
# BOOKRAG_MODEL_CACHE=./data/models
# Custom embedding revisions should be pinned; registered defaults already are
# BOOKRAG_EMBEDDING_REVISION=<commit-sha>
# Optional offline answers; see docs/LOCAL_GENERATION.md for explicit acquisition
# BOOKRAG_GENERATION_PROFILE=qwen2.5-1.5b
# BOOKRAG_GENERATION_MODEL=./data/models/local-generation/qwen2.5-1.5b-instruct-q4_k_m.gguf
# BOOKRAG_GENERATION_CONTEXT=8192
# BOOKRAG_GENERATION_THREADS=4
# BOOKRAG_GENERATION_GPU_LAYERS=-1
# Optional scoped Russian semantic overlay, explicitly prepared before enabling
# BOOKRAG_SEMANTIC_OVERLAY=./data/semantic-overlays/ru21-live-v1/installation.json
